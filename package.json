{
  "name": "glanceline",
  "productName": "Glanceline",
  "appUserModelId": "io.github.crisiodev.glanceline",
  "version": "0.1.0",
  "description": "Teleprompter companion for streamers and presenters: Twitch chat with 7TV, scrolling script, OBS status and PowerPoint notes on your Elgato Prompter",
  "main": "main.js",
  "private": true,
  "author": "Crisio",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "server": "node server/index.js",
    "test": "node --test \"test/*.test.js\"",
    "check": "node tools/check-i18n.js && node tools/check-syntax.js && node tools/version.js check",
    "smoke": "node tools/smoke.js",
    "version": "node tools/version.js sync && git add CHANGELOG.md integrations/streamdeck/io.github.crisiodev.glanceline.sdPlugin/manifest.json integrations/chrome-slides/manifest.json",
    "dist": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "icon": "node tools/make-icon.js",
    "shortcut": "electron tools/create-shortcuts.js",
    "check:i18n": "node tools/check-i18n.js",
    "pack:streamdeck": "node tools/pack-streamdeck.js",
    "icons:streamdeck": "electron tools/make-streamdeck-assets.js",
    "pack:slides": "node tools/pack-slides.js"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "io.github.crisiodev.glanceline",
    "productName": "Glanceline",
    "copyright": "Copyright © 2026 Crisio",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "package.json",
      "server/**/*",
      "public/**/*",
      "assets/**/*",
      "integrations/**/*"
    ],
    "asarUnpack": [
      "server/ppt-bridge.ps1",
      "server/display-power.ps1",
      "integrations/chrome-slides/**",
      "server/voice-worker.js",
      "node_modules/sherpa-onnx-node/**",
      "node_modules/sherpa-onnx-win-x64/**",
      "server/mac-slides.js",
      "node_modules/sherpa-onnx-darwin-arm64/**",
      "node_modules/sherpa-onnx-darwin-x64/**"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    },
    "publish": {
      "provider": "github",
      "releaseType": "draft"
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Glanceline",
      "artifactName": "Glanceline-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Glanceline-${version}-portable.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg"
        },
        {
          "target": "zip"
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "assets/icon-1024.png",
      "artifactName": "Glanceline-${version}-mac-${arch}.${ext}",
      "extendInfo": {
        "NSAppleEventsUsageDescription": "Glanceline reads the current slide and speaker notes from Keynote or PowerPoint.",
        "NSCameraUsageDescription": "Glanceline can show your camera image behind the prompter text.",
        "NSMicrophoneUsageDescription": "Voice tracking listens to you and follows your script."
      }
    }
  },
  "dependencies": {
    "sherpa-onnx-node": "^1.13.8"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/CrisioDev/glanceline.git"
  },
  "homepage": "https://github.com/CrisioDev/glanceline"
}
